params {
    samples_table    = "$projectDir/samples.csv"
    outdir           = "$projectDir/results"
    
    reference_genome = "$projectDir/data/reference.fasta"
    gtf              = "$projectDir/data/annotation.gtf"
    
    cache_dir        = "$System.env.HOME/.cache/dorado_models"
}

process {
    container = 'mordziarz/transcriptomelongpipeline:latest'

    env.DORADO_MODELS_DIRECTORY = '/opt/dorado_models'

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }
    withLabel: 'process_medium' {
        cpus   = 4
        memory = '16.GB'
        time   = '6.h'
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = '48.GB'
        time   = '16.h'
    }

    withName: 'DORADO_BASECALL' {
        memory = null
        container = false
        maxForks = 1
    }
    withName: 'MINIMAP2_ALIGN' {
        label = 'process_high'
    }
    withName: 'ISOQUANT' {
        label = 'process_high'
    }
}

docker {
    enabled = true
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/execution_timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/execution_report.html"; overwrite = true }
